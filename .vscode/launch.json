{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "运行 SVG Outline 扩展",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-svg",
        "${workspaceFolder}/packages/vscode-svg/samples"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/vscode-svg/dist/**/*.js"
      ]
    }
  ]
}

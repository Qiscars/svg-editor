{
  "name": "svg-editor",
  "version": "0.2.0",
  "private": true,
  "description": "Lab1 Phase 2 — 可插件化的 CLI SVG 编辑器（内核 + 插件 + 宿主）",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "cli": "pnpm run build && node packages/host/dist/main.js",
    "start": "node packages/host/dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:layers": "node tools/check-layers.mjs",
    "metrics": "node tools/metrics.mjs",
    "verify:assembly": "node tools/verify-assembly.mjs",
    "verify": "node tools/verify.mjs"
  },
  "devDependencies": {
    "@svgframe/host": "workspace:*",
    "@svgframe/kernel": "workspace:*",
    "@svgframe/plugin-command-dir": "workspace:*",
    "@svgframe/plugin-command-stats": "workspace:*",
    "@svgframe/plugin-shape-box": "workspace:*",
    "@svgframe/plugin-shape-diamond": "workspace:*",
    "@svgframe/plugin-tree-star": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

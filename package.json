{
  "name": "svg-editor",
  "version": "0.1.0",
  "private": true,
  "description": "Lab1 Phase 1 — 命令行 SVG 编辑器（TypeScript + OOP + Command/Composite 设计模式）",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "svg-editor": "dist/main.js"
  },
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "tsc -p tsconfig.json && node dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:layers": "node tools/check-layers.mjs",
    "verify": "npm run build && npm run typecheck && npm test && npm run check:layers"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}

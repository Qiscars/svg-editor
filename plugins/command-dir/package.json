{
  "name": "@svgframe/plugin-command-dir",
  "version": "0.2.0",
  "private": true,
  "description": "dir 命令插件：通过目录访问适配器列出当前工作目录",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "contributes": {
    "commands": ["dir"]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@svgframe/kernel": "workspace:*"
  },
  "devDependencies": {
    "@svgframe/kernel": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}

{
  "name": "svgframe-vscode",
  "displayName": "SVG Outline",
  "description": "在 VSCode 资源管理器中标记 SVG 文件，并在原生大纲（Outline）中展示 SVG 元素层级。",
  "version": "0.1.0",
  "publisher": "svgframe",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:svg",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "svgframe.focusOutline",
        "title": "聚焦 SVG 大纲",
        "category": "SVG"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.85.0",
    "typescript": "^7.0.2"
  }
}
